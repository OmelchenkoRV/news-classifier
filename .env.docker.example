# .env.docker — Environment for Docker container
# ==================================================
# Copy to .env.docker and fill in your values.
#
# IMPORTANT: DB_HOST must be host.docker.internal (not localhost)
# because the container needs to reach PostgreSQL on your host machine.

# Database — host PostgreSQL
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=news_classifier
DB_USER=postgres
DB_PASSWORD=

# CoinDesk API (not used by live pipeline, but kept for compatibility)
COINDESK_API_KEY=''

# Pipeline configuration
POLL_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
ALERT_ON_TIGHTEN=true
MODEL_VERSION=v2
